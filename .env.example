# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Supabase PostgreSQL via Prisma)
# Transaction pooler (port 6543) - used by Prisma at runtime
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct connection (port 5432) - used by Prisma for migrations
DIRECT_URL=postgresql://postgres:your-password@db.your-ref.supabase.co:5432/postgres

# App
NEXT_PUBLIC_APP_URL=https://yourapp.vercel.app
